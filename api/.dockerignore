# Build context for api/Dockerfile: only requirements.txt, app/, data/demo and data/reference
# are copied; everything local, generated or secret stays out.
.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
tests/
scripts/
!scripts/build_static_responses.py

# Data not needed in DEMO_MODE (and large or git-ignored)
data/raw/
data/cache/
data/processed/
data/state/
data/static/

# Secrets: never in the image (Render provides keys as env vars)
.env
.env.*
!.env.example
**/.env
secrets/
*.json.key
